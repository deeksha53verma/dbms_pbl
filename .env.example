# PostgreSQL Connection Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rotaract_rvce
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Flask Security Configuration
FLASK_SECRET_KEY=replace-with-a-long-random-secret-key
FLASK_ENV=development
PORT=5000

# Optional SMTP Configuration for Real Email OTP Delivery
# (For Gmail: use SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and a Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
